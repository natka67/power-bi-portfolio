{
  "name": "Clear Data Analytics",
  "dataColors": [
    "#2E75B6",
    "#548235",
    "#ED7D31",
    "#BF8F00",
    "#C00000",
    "#808080"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2A37",
  "tableAccent": "#2E75B6",
  "textClasses": {
    "callout": {
      "fontFace": "Calibri",
      "fontSize": 28,
      "color": "#1F2A37"
    },
    "title": {
      "fontFace": "Calibri",
      "fontSize": 14,
      "color": "#1F2A37"
    },
    "header": {
      "fontFace": "Calibri",
      "fontSize": 12,
      "color": "#1F2A37"
    },
    "label": {
      "fontFace": "Calibri",
      "fontSize": 11,
      "color": "#595959"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontFamily": "Calibri",
            "fontSize": 14,
            "color": {
              "solid": {
                "color": "#1F2A37"
              }
            }
          }
        ],
        "labels": [
          {
            "fontFamily": "Calibri",
            "color": {
              "solid": {
                "color": "#595959"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelFontFamily": "Calibri",
            "labelColor": {
              "solid": {
                "color": "#595959"
              }
            },
            "titleFontFamily": "Calibri",
            "titleColor": {
              "solid": {
                "color": "#1F2A37"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelFontFamily": "Calibri",
            "labelColor": {
              "solid": {
                "color": "#595959"
              }
            },
            "titleFontFamily": "Calibri",
            "titleColor": {
              "solid": {
                "color": "#1F2A37"
              }
            }
          }
        ],
        "legend": [
          {
            "fontFamily": "Calibri",
            "labelColor": {
              "solid": {
                "color": "#595959"
              }
            },
            "titleFontFamily": "Calibri",
            "titleColor": {
              "solid": {
                "color": "#1F2A37"
              }
            }
          }
        ]
      }
    }
  }
}
