	column 'Median Monthly Salary'
		dataType: double
		lineageTag: 5079eb26-ab24-4425-b3a9-909d7e4ea001
		summarizeBy: none
		sourceColumn: Median Monthly Salary

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '_Maximum Tax Rate' = convert('Salaries Aggregated'[_Maximum Tax Rate as Number]*100,STRING) & "% rate" --switch( TRUE(), [Annual Salary] <= 12570, "0% rate", [Annual Salary] <= 50270, "20% rate", [Annual Salary] <= 125140, "40% rate", "45% rate")
		lineageTag: a9dd4239-c618-4de0-8519-0d92f5ab0065
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '_Maximum Tax Rate as Number' = switch( TRUE(), [Annual Salary] <= [_20% Salary Value], 0, [Annual Salary] <= [_40% Salary Value], 0.2, [Annual Salary] <= [_45% Salary Value], 0.4, 0.45)
		lineageTag: ef6c3a6d-3029-46b3-8db8-71297235e779
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '_20% Tax Paid' = IF('Salaries Aggregated'[_Maximum Tax Rate as Number]>0, 0.2*[Annual Salary], 0)
		lineageTag: ebc8c139-0071-4481-9253-f4c4ef6d6cd4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '_40% Tax Paid' = if('Salaries Aggregated'[_Maximum Tax Rate as Number] >0.2, 0.4*([Annual Salary] - [_20% Salary Value]),0)
		lineageTag: 39ba0dbe-fffb-4883-9082-64c97e351dac
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '_45% Tax Paid' = if('Salaries Aggregated'[_Maximum Tax Rate as Number] >0.4, 0.45*([Annual Salary] - ([_20% Salary Value]+[_40% Salary Value])),0)
		formatString: 0
		lineageTag: e91aa5cf-a320-4b75-a58d-9321454dc338
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '_Annual Tax Paid' = 'Salaries Aggregated'[_20% Tax Paid]+ 'Salaries Aggregated'[_40% Tax Paid]+'Salaries Aggregated'[_45% Tax Paid]
		lineageTag: 65195a5c-8a7f-465e-8ac2-58c5cdce8c90
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'Salaries Aggregated' = m
		mode: import
		source =
				let
				    #"Grouped Rows" = Table.Group(#"Salaries Raw", {"StaffID"}, {{"Annual Salary", each List.Sum([Salary]), type nullable number}, {"Maximum Monthly Salary", each List.Max([Salary]), type nullable number}, {"Minimum Monthly Salary", each List.Min([Salary]), type nullable number}, {"Average Monthly Salary", each List.Average([Salary]), type nullable number}, {"Median Monthly Salary", each List.Median([Salary]), type nullable number}})
				in
				    #"Grouped Rows"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

